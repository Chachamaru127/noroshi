{
	"$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
	"name": "quickmail-ja-setup",
	"version": "1.0.0",
	"description": "QuickMail-jaのBYOK導入を、固定されたセットアップ契約に沿って案内・検証するプラグイン。",
	"author": {
		"name": "QuickMail-ja"
	},
	"license": "MIT",
	"keywords": ["quickmail-ja", "setup", "byok", "cloudflare", "resend", "japanese"],
	"extensions": {
		"com.quickmail-ja.setup": {
			"capability_registry": "setup/plugin-capabilities.json",
			"mailbox_permissions": {
				"read": false,
				"send": false,
				"admin": false
			},
			"exposed_capability_ids": [],
			"provider_email_access": false,
			"provider_adapter_status": "not-enabled"
		}
	}
}
