{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://quickmail-ja.example/schemas/source-registry.schema.json",
	"title": "QuickMail-ja support source registry",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"$schema",
		"version",
		"verified_at",
		"review_by",
		"entries",
		"authoritative_provider_sources"
	],
	"properties": {
		"$schema": { "const": "./source-registry.schema.json" },
		"version": { "type": "integer", "const": 1 },
		"verified_at": { "$ref": "#/$defs/date" },
		"review_by": { "$ref": "#/$defs/date" },
		"entries": {
			"type": "array",
			"minItems": 24,
			"maxItems": 24,
			"items": { "$ref": "#/$defs/source" }
		},
		"authoritative_provider_sources": {
			"type": "array",
			"minItems": 1,
			"items": { "$ref": "#/$defs/source" }
		}
	},
	"$defs": {
		"date": { "type": "string", "format": "date" },
		"confidence": { "enum": ["high", "medium", "low"] },
		"discovery": {
			"oneOf": [
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["status", "url", "source_type"],
					"properties": {
						"status": { "const": "found" },
						"url": { "type": "string", "format": "uri", "pattern": "^https://" },
						"source_type": { "const": "primary" },
						"related_urls": {
							"type": "array",
							"minItems": 1,
							"uniqueItems": true,
							"items": { "type": "string", "format": "uri", "pattern": "^https://" }
						}
					}
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["status", "searched_at", "note"],
					"properties": {
						"status": { "enum": ["not_found", "not_applicable"] },
						"searched_at": { "$ref": "#/$defs/date" },
						"note": { "type": "string", "minLength": 1, "maxLength": 160 }
					}
				}
			]
		},
		"source": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"id",
				"name",
				"category",
				"canonical_url",
				"setup",
				"faq",
				"verified_at",
				"review_by",
				"confidence"
			],
			"properties": {
				"id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
				"name": { "type": "string", "minLength": 1 },
				"category": { "type": "string", "minLength": 1 },
				"canonical_url": { "type": "string", "format": "uri", "pattern": "^https://" },
				"setup": { "$ref": "#/$defs/discovery" },
				"faq": { "$ref": "#/$defs/discovery" },
				"verified_at": { "$ref": "#/$defs/date" },
				"review_by": { "$ref": "#/$defs/date" },
				"confidence": { "$ref": "#/$defs/confidence" }
			}
		}
	}
}
