{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://noroshi.example/schemas/support-patterns.schema.json",
	"title": "Noroshi Japanese support patterns",
	"type": "object",
	"additionalProperties": false,
	"required": ["$schema", "version", "verified_at", "review_by", "setup_runbook", "patterns"],
	"properties": {
		"$schema": { "const": "./support-patterns.schema.json" },
		"version": { "type": "integer", "const": 1 },
		"verified_at": { "$ref": "#/$defs/date" },
		"review_by": { "$ref": "#/$defs/date" },
		"setup_runbook": { "$ref": "#/$defs/setupRunbook" },
		"patterns": {
			"type": "array",
			"minItems": 10,
			"maxItems": 15,
			"items": { "$ref": "#/$defs/pattern" }
		}
	},
	"$defs": {
		"date": { "type": "string", "format": "date" },
		"strings": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
		"setupRunbook": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"computer_use_boundary",
				"approval_policy",
				"recovery_policy",
				"canary_token_policy",
				"canary_surfaces",
				"dns_evidence",
				"stages",
				"deferred",
				"not_adopted"
			],
			"properties": {
				"computer_use_boundary": { "type": "string", "minLength": 1 },
				"approval_policy": { "type": "string", "minLength": 1 },
				"recovery_policy": { "type": "string", "minLength": 1 },
				"canary_token_policy": { "type": "string", "minLength": 1 },
				"canary_surfaces": { "$ref": "#/$defs/strings" },
				"dns_evidence": { "type": "string", "minLength": 1 },
				"stages": {
					"type": "array",
					"minItems": 11,
					"maxItems": 11,
					"items": { "$ref": "#/$defs/setupStage" }
				},
				"deferred": { "$ref": "#/$defs/strings" },
				"not_adopted": { "$ref": "#/$defs/strings" }
			}
		},
		"setupStage": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"id",
				"title_ja",
				"ai_reads",
				"human_action",
				"risk_gate",
				"completion_evidence",
				"rollback_to"
			],
			"properties": {
				"id": {
					"enum": [
						"preflight",
						"resend_authentication",
						"d1_r2",
						"migration",
						"deploy",
						"secrets",
						"email_routing",
						"first_admin",
						"outbound_send",
						"reply_receive",
						"rollback"
					]
				},
				"title_ja": { "type": "string", "minLength": 1 },
				"ai_reads": { "$ref": "#/$defs/strings" },
				"human_action": { "$ref": "#/$defs/strings" },
				"risk_gate": {
					"type": "object",
					"additionalProperties": false,
					"required": ["required", "scope"],
					"properties": {
						"required": { "type": "boolean" },
						"scope": { "type": "string", "minLength": 1 }
					}
				},
				"completion_evidence": { "$ref": "#/$defs/strings" },
				"rollback_to": { "$ref": "#/$defs/strings" }
			}
		},
		"pattern": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"id",
				"title_ja",
				"category",
				"stage",
				"applicability",
				"diagnostic_questions",
				"safe_steps",
				"human_only",
				"prohibited",
				"risk_gate",
				"rollback",
				"expected_evidence",
				"unsupported",
				"source_refs",
				"verified_at",
				"review_by",
				"confidence"
			],
			"properties": {
				"id": { "type": "string", "pattern": "^[a-z0-9]+(?:\\.[a-z0-9]+)*$" },
				"title_ja": { "type": "string", "minLength": 1 },
				"category": {
					"enum": [
						"deployment",
						"cloudflare",
						"dns",
						"storage",
						"resend",
						"onboarding",
						"delivery",
						"backup",
						"migration"
					]
				},
				"stage": { "type": "string", "minLength": 1 },
				"applicability": { "$ref": "#/$defs/strings" },
				"diagnostic_questions": { "$ref": "#/$defs/strings" },
				"safe_steps": { "$ref": "#/$defs/strings" },
				"human_only": { "$ref": "#/$defs/strings" },
				"prohibited": { "$ref": "#/$defs/strings" },
				"risk_gate": {
					"type": "object",
					"additionalProperties": false,
					"required": ["class", "trigger", "approval_required"],
					"properties": {
						"class": { "type": "string", "minLength": 1 },
						"trigger": { "type": "string", "minLength": 1 },
						"approval_required": { "type": "boolean" }
					}
				},
				"rollback": { "$ref": "#/$defs/strings" },
				"expected_evidence": { "$ref": "#/$defs/strings" },
				"unsupported": { "$ref": "#/$defs/strings" },
				"source_refs": { "$ref": "#/$defs/strings" },
				"verified_at": { "$ref": "#/$defs/date" },
				"review_by": { "$ref": "#/$defs/date" },
				"confidence": { "enum": ["high", "medium", "low"] }
			}
		}
	}
}
