# Copy this file to .dev.vars for non-secret local settings only.
# Never put credentials, setup keys, API keys, or webhook secrets in this file.
# `bun run setup -- --local-dev` receives the setup key from the current process
# and passes secrets only to its child development server.

# The first release supports Resend outbound only. Set this in wrangler.jsonc
# vars for production; uncomment here only to override locally.
# EMAIL_PROVIDER=resend
# INBOUND_EMAIL_PROVIDER=cloudflare
# `bun run setup -- --local-dev --domain example.com` injects this setting into
# the child process. Do not leave the example domain unchanged.
# CLOUDFLARE_MAIL_DOMAINS=example.com
# RESEND_SEND_DOMAINS=example.com

# Production secrets are entered through Cloudflare's native secret prompt:
# BOOTSTRAP_SECRET, AUTH_RATE_LIMIT_SECRET, RESEND_API_KEY, RESEND_WEBHOOK_SECRET.
# The Worker receives only a domain-restricted Resend sending key.

# Optional Web Push public metadata may be set as non-secret vars:
# VAPID_PUBLIC_KEY and VAPID_SUBJECT. Register VAPID_PRIVATE_KEY only through
# the native `wrangler secret put VAPID_PRIVATE_KEY` prompt.
