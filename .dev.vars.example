# Copy this file to .dev.vars and fill in real values.
# .dev.vars is gitignored — never commit it.
#
# In production these live as Worker secrets / vars instead.

# Required to create the first administrator. Use a unique random value.
BOOTSTRAP_SECRET=REPLACE_WITH_A_LONG_RANDOM_SETUP_KEY

# The first release supports Resend outbound only. Set this in wrangler.jsonc
# vars for production; uncomment here only to override locally.
# EMAIL_PROVIDER=resend
# INBOUND_EMAIL_PROVIDER=cloudflare
# CLOUDFLARE_MAIL_DOMAINS=example.com

# --- Resend (EMAIL_PROVIDER=resend) ---
# From https://resend.com/api-keys — the current setup flow needs full access
# for sending, domain inspection, and webhook creation. Keep Receiving disabled.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Shown once when you create the webhook at https://resend.com/webhooks
# (see the README). Starts with whsec_.
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Desktop notifications (optional) ---
# Generate once with: bunx web-push generate-vapid-keys
# Production values should be added with `wrangler secret put`, not committed.
# VAPID_PUBLIC_KEY=REPLACE_WITH_YOUR_VAPID_PUBLIC_KEY
# VAPID_PRIVATE_KEY=REPLACE_WITH_YOUR_VAPID_PRIVATE_KEY
# VAPID_SUBJECT=mailto:admin@example.com
