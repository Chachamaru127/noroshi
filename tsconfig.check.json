{
	"extends": "./tsconfig.json",
	"include": [
		".svelte-kit/ambient.d.ts",
		".svelte-kit/non-ambient.d.ts",
		".svelte-kit/types/**/$types.d.ts",
		"src/**/*.ts",
		"src/**/*.svelte",
		"vite.config.ts"
	],
	"exclude": [
		"node_modules/**",
		".svelte-kit/output/**",
		"build/**",
		".wrangler/**",
		"src/service-worker.js",
		"src/service-worker/**/*.js",
		"src/service-worker.ts",
		"src/service-worker/**/*.ts",
		"src/service-worker.d.ts",
		"src/service-worker/**/*.d.ts",
		"src/sveltekit-worker.js"
	]
}
