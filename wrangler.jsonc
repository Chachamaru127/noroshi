{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "quickmail-ja",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2025-06-01",
	"compatibility_flags": ["nodejs_compat", "enable_nodejs_http_modules"],
	"workers_dev": true,
	"triggers": {
		"crons": ["*/1 * * * *"]
	},

	// Your Cloudflare account is picked up from `wrangler login`. If you belong
	// to more than one account, set CLOUDFLARE_ACCOUNT_ID in your environment
	// or uncomment this and paste the ID from the Cloudflare dashboard sidebar.
	// "account_id": "",

	// Deploys to <name>.<your-subdomain>.workers.dev out of the box. To serve it
	// from your own domain instead, uncomment this and make sure the zone is on
	// the same Cloudflare account.
	// "routes": [
	// 	{
	// 		"pattern": "mail.example.com",
	// 		"custom_domain": true
	// 	}
	// ],

	"assets": {
		"directory": ".svelte-kit/cloudflare",
		"binding": "ASSETS"
	},

	// Prefer `bun run setup` (or `bash scripts/setup.sh`) over editing this by hand.
	// The first release uses Resend for outbound and Cloudflare Email Routing for inbound.
	// Set CLOUDFLARE_MAIL_DOMAINS before deploy so the Worker accepts the domain.
	// Setup and Resend secrets:
	//   wrangler secret put BOOTSTRAP_SECRET
	//   wrangler secret put RESEND_API_KEY
	//   wrangler secret put RESEND_WEBHOOK_SECRET
	// Locally, put values in .dev.vars (copy .dev.vars.example).

	"vars": {
		"EMAIL_PROVIDER": "resend",
		"INBOUND_EMAIL_PROVIDER": "cloudflare",
		// Comma-separated domains onboarded in Email Service / Email Routing.
		"CLOUDFLARE_MAIL_DOMAINS": ""
	},

	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "quickmail-ja",
			"database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID",
			"migrations_dir": "migrations"
		}
	],

	"r2_buckets": [
		{
			"binding": "ATTACHMENTS",
			"bucket_name": "quickmail-ja-attachments"
		}
	],

	"observability": {
		"enabled": true
	}
}
