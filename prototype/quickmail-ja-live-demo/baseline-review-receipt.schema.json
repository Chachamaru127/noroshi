{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "QuickMail-ja live demo baseline review receipt",
	"type": "object",
	"additionalProperties": false,
	"required": ["commit", "container", "reviewed_at", "reviewer", "decision", "screenshots"],
	"properties": {
		"commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
		"container": { "const": "mcr.microsoft.com/playwright:v1.59.1-noble" },
		"reviewed_at": { "type": "string", "format": "date-time" },
		"reviewer": { "type": "string", "minLength": 1 },
		"decision": { "enum": ["APPROVE", "REQUEST_CHANGES"] },
		"notes": { "type": "string" },
		"screenshots": {
			"type": "array",
			"minItems": 18,
			"maxItems": 18,
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["file", "sha256"],
				"properties": {
					"file": {
						"type": "string",
						"pattern": "^[a-z]+-(light|dark)-(desktop|tablet|mobile)\\.png$"
					},
					"sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
				}
			}
		}
	}
}
