{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "QuickMail-ja approved live demo baseline review receipt",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"reviewedCommit",
		"baselineVersion",
		"containerImage",
		"imageDigest",
		"reviewedAt",
		"reviewer",
		"decision",
		"screenshots"
	],
	"properties": {
		"reviewedCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
		"baselineVersion": { "const": "playwright-1.59.1-noble-linux-amd64" },
		"containerImage": {
			"const": "mcr.microsoft.com/playwright@sha256:eac9b0a5312cdab40ee8c2429df5bf19bffdccf8f3bf3c42268e173f97541645"
		},
		"imageDigest": {
			"const": "sha256:eac9b0a5312cdab40ee8c2429df5bf19bffdccf8f3bf3c42268e173f97541645"
		},
		"reviewedAt": { "type": "string", "format": "date-time" },
		"reviewer": { "type": "string", "minLength": 1 },
		"decision": { "const": "APPROVE" },
		"notes": { "type": "string" },
		"screenshots": {
			"type": "array",
			"minItems": 18,
			"maxItems": 18,
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["file", "sha256"],
				"properties": {
					"file": {
						"type": "string",
						"pattern": "^(calm|command|classic)-(light|dark)-(desktop|tablet|mobile)\\.png$"
					},
					"sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
				}
			}
		}
	}
}
